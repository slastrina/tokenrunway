{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokenrunway",
  "version": "0.3.0",
  "identifier": "io.github.slastrina.tokenrunway",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Every AI subscription's allowance, resets and spend in your menubar",
    "longDescription": "Tokenrunway shows how much AI runway you have left: the usage windows, resets and forecasts of your Claude, ChatGPT/Codex, Bedrock and other accounts, with notifications before you run out and local stats by model, harness and kind of work.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": [
          "gnome-keyring"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMzkyMjA2QUZCRDYzMDQKUldRRVk3MnZCaUk1YmV0QXlWMWloNWNVS0xFRk9ubVVoMC9KeWZ2VFVFMjhIcnVDTkpSVVFtMGcK",
      "endpoints": [
        "https://github.com/slastrina/tokenrunway/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
